# Use specific version tag to prevent unnecessary cache invalidation
FROM quay.io/almalinuxorg/9-base:9.5

ARG USD_VERSION=25.05.1
ARG USD_TARBALL_URL=https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/v25.05.01.tar.gz

ENV USD_VERSION=${USD_VERSION}
ENV USD_TARBALL_URL=${USD_TARBALL_URL}

# Enable CRB and EPEL for build dependencies
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y install epel-release && \
    dnf clean all

# Install compiler toolchain and USD build dependencies
RUN dnf -y update && \
    dnf -y groupinstall "Development Tools" && \
    dnf -y install --setopt=install_weak_deps=False \
        cmake \
        ninja-build \
        git \
        curl \
        wget \
        tar \
        gzip \
        xz \
        unzip \
        bzip2 \
        patch \
        pkgconfig \
        python3 \
        python3-devel \
        python3-pip \
        tbb-devel \
        boost-devel \
        boost-python3-devel \
        zlib-devel \
        libpng-devel \
        libjpeg-turbo-devel \
        libtiff-devel \
        OpenEXR-devel \
        OpenImageIO-devel \
        mesa-libGL-devel \
        mesa-libGLU-devel \
        libX11-devel \
        libXrandr-devel \
        libXcursor-devel \
        libXi-devel \
        libXinerama-devel \
        libXxf86vm-devel && \
    dnf clean all

WORKDIR /opt/src

CMD ["/bin/bash"]
