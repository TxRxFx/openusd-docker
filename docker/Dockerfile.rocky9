# Use specific version tag to prevent unnecessary cache invalidation
FROM quay.io/rockylinux/rockylinux:9.5


ARG USD_VERSION=25.05.1
ARG USD_TARBALL_URL=https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/v${USD_VERSION}.tar.gz
ARG PYTHON_VERSION=3.11.18
ARG REZ_VERSION=3.5.0

ENV USD_VERSION=${USD_VERSION}
ENV USD_TARBALL_URL=${USD_TARBALL_URL}
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV PYVER_PATH=/opt/python/${PYTHON_VERSION}
ENV PATH=${PYVER_PATH}/bin:${PATH}

# Enable CRB and EPEL for build dependencies
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y install epel-release && \
    dnf clean all

# Install compiler toolchain and USD build dependencies
RUN dnf -y update && \
    dnf -y groupinstall "Development Tools" && \
    dnf -y install --allowerasing --setopt=install_weak_deps=False \
        gcc-toolset-12 \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        gcc-toolset-12-binutils \
        cmake \
        ninja-build \
        git \
        curl-minimal \
        wget \
        tar \
        gzip \
        xz \
        unzip \
        bzip2 \
        patch \
        pkgconfig \
        doxygen \
        graphviz \
        openssl-devel \
        libffi-devel \
        bzip2-devel \
        xz-devel \
        readline-devel \
        sqlite-devel \
        gdbm-devel \
        ncurses-devel \
        tk-devel \
        libuuid-devel \
        tbb-devel \
        boost-devel \
        boost-python3-devel \
        zlib-devel \
        libpng-devel \
        libjpeg-turbo-devel \
        turbojpeg-devel \
        libtiff-devel \
        OpenEXR-devel \
        OpenImageIO-devel \
        mesa-libGL-devel \
        mesa-libGLU-devel \
        libX11-devel \
        libXt-devel \
        libXmu-devel \
        libXrandr-devel \
        libXcursor-devel \
        libXi-devel \
        libXinerama-devel \
        libXxf86vm-devel \
        libxkbcommon-devel && \
    dnf clean all

# Install Python from source and pin pip packages used by build_usd.py/usdview checks
RUN set -euxo pipefail; \
    source /opt/rh/gcc-toolset-12/enable; \
    mkdir -p /tmp/python-src; \
    curl -L "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" -o /tmp/python-src/Python.tgz; \
    tar -xzf /tmp/python-src/Python.tgz -C /tmp/python-src; \
    cd /tmp/python-src/Python-${PYTHON_VERSION}; \
    ./configure --prefix="${PYVER_PATH}" --enable-optimizations --enable-shared --with-ensurepip=install; \
    make -j"$(nproc)"; \
    make install; \
    ln -sf "${PYVER_PATH}/bin/python3.11" "${PYVER_PATH}/bin/python"; \
    echo "${PYVER_PATH}/lib" > /etc/ld.so.conf.d/python-${PYTHON_VERSION}.conf; \
    ldconfig; \
    "${PYVER_PATH}/bin/python" -m pip install --no-cache-dir --upgrade pip setuptools wheel; \
    # "${PYVER_PATH}/bin/python" -m pip install --no-cache-dir "Jinja2" "PySide6==6.5.2" "PyOpenGL"; \
    rm -rf /tmp/python-src

# Set Rez envs
ENV REZ_ROOT=/opt/rez/current
ENV PYTHONPATH=/opt/rez/current
ENV REZ_CONFIG_FILE=/mnt/packages/.config/linux_rezconfig.py
ENV PATH="/opt/rez/current/bin:${PATH}"

# Install Rez from source using the official installer
RUN mkdir -p /tmp/rez-src && \
    curl -fL "https://github.com/AcademySoftwareFoundation/rez/archive/refs/tags/${REZ_VERSION}.tar.gz" \
        -o /tmp/rez.tar.gz && \
    tar -xzf /tmp/rez.tar.gz -C /tmp/rez-src --strip-components=1 && \
    cd /tmp/rez-src && \
    "${PYVER_PATH}/bin/python" install.py "/opt/rez/${REZ_VERSION}" && \
    ln -sfn "/opt/rez/${REZ_VERSION}" /opt/rez/current && \
    rm -rf /tmp/rez-src /tmp/rez.tar.gz

# Configure Rez
ENV REZ_ROOT=/opt/rez/current
ENV REZ_CONFIG_FILE=/mnt/packages/.config/linux_rezconfig.py
ENV PATH="/opt/rez/current/bin/rez:${PATH}"

# Verify Rez installation
RUN rez --version
RUN echo "************************"

WORKDIR /opt/src

CMD ["/bin/bash"]