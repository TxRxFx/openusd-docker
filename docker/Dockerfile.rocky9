# Use specific version tag to prevent unnecessary cache invalidation
FROM quay.io/rockylinux/rockylinux:9.5


ARG USD_VERSION=25.08
ARG USD_TARBALL_URL=https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/v25.08.zip
ARG PYTHON_VERSION=3.10.14
ARG GCCCORE_VERSION=12.3.0

ENV USD_VERSION=${USD_VERSION}
ENV USD_TARBALL_URL=${USD_TARBALL_URL}
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV GCCCORE_VERSION=${GCCCORE_VERSION}
ENV PY310_PREFIX=/pipeline/el9/software/Python/${PYTHON_VERSION}-GCCcore-${GCCCORE_VERSION}
ENV PATH=${PY310_PREFIX}/bin:${PATH}

# Enable CRB and EPEL for build dependencies
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y install epel-release && \
    dnf clean all

# Install compiler toolchain and USD build dependencies
RUN dnf -y update && \
    dnf -y groupinstall "Development Tools" && \
    dnf -y install --allowerasing --setopt=install_weak_deps=False \
        gcc-toolset-12 \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        gcc-toolset-12-binutils \
        cmake \
        ninja-build \
        git \
        curl-minimal \
        wget \
        tar \
        gzip \
        xz \
        unzip \
        bzip2 \
        patch \
        pkgconfig \
        doxygen \
        graphviz \
        openssl-devel \
        libffi-devel \
        bzip2-devel \
        xz-devel \
        readline-devel \
        sqlite-devel \
        gdbm-devel \
        ncurses-devel \
        tk-devel \
        libuuid-devel \
        tbb-devel \
        boost-devel \
        boost-python3-devel \
        zlib-devel \
        libpng-devel \
        libjpeg-turbo-devel \
        turbojpeg-devel \
        libtiff-devel \
        OpenEXR-devel \
        OpenImageIO-devel \
        mesa-libGL-devel \
        mesa-libGLU-devel \
        libX11-devel \
        libXt-devel \
        libXmu-devel \
        libXrandr-devel \
        libXcursor-devel \
        libXi-devel \
        libXinerama-devel \
        libXxf86vm-devel \
        libxkbcommon-devel && \
    dnf clean all

# Install Python 3.10.14 from source and pin pip packages used by build_usd.py/usdview checks
RUN set -euxo pipefail; \
    source /opt/rh/gcc-toolset-12/enable; \
    mkdir -p /tmp/python-src; \
    curl -L "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" -o /tmp/python-src/Python.tgz; \
    tar -xzf /tmp/python-src/Python.tgz -C /tmp/python-src; \
    cd /tmp/python-src/Python-${PYTHON_VERSION}; \
    ./configure --prefix="${PY310_PREFIX}" --enable-optimizations --enable-shared --with-ensurepip=install; \
    make -j"$(nproc)"; \
    make install; \
    ln -sf "${PY310_PREFIX}/bin/python3.10" "${PY310_PREFIX}/bin/python"; \
    echo "${PY310_PREFIX}/lib" > /etc/ld.so.conf.d/python-${PYTHON_VERSION}.conf; \
    ldconfig; \
    "${PY310_PREFIX}/bin/python" -m pip install --no-cache-dir --upgrade pip setuptools wheel; \
    "${PY310_PREFIX}/bin/python" -m pip install --no-cache-dir "Jinja2" "PySide6==6.5.2" "PyOpenGL"; \
    rm -rf /tmp/python-src

WORKDIR /opt/src

CMD ["/bin/bash"]
